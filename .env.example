# Copy to .env.local for local testing, and add the same keys in Vercel →
# Project → Settings → Environment Variables. Never commit real values.

# Company mailbox SMTP (from your email provider's settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465, false for 587 (leave empty to decide from the port)
SMTP_SECURE=
SMTP_USER=info@hydrohubindustries.com
# Google Workspace app password (2-Step Verification → App passwords), not the normal login password
SMTP_PASS=

# Sender shown on both emails (usually the same mailbox as SMTP_USER)
MAIL_FROM="Hydro Hub Industries <info@hydrohubindustries.com>"

# Inbox that receives every new enquiry
ENQUIRY_TO=info@hydrohubindustries.com
